# Copy to .env and fill in. Never put a private key here: the key lives in an encrypted keystore.

# Your FREEDZ token ids, and the pot each one waits for: one value for all, or one per token in the same
# order. Each block the bot signs for the highest target the pot already meets, else the lowest target.
TOKEN_IDS=1234,5678
TARGET_ETH=0.0128,0.02
# Or dollar targets instead (ETH/USD from Chainlink, re-read every minute):
# TARGET_USD=30,47

# Encrypted keystore made with:  cast wallet import freedz --interactive
KEYSTORE=C:\Users\YOU\.foundry\keystores\freedz
# Optional, for running without a terminal prompt (keep the file private):
# KEYSTORE_PASSWORD_FILE=C:\path\to\password.txt

# Tip per gas for the builders. Winning burns on 10-29 paid 0.44-2.8 gwei in total (base fee ~0.4).
# You only pay it when a burn lands: ~100k gas x 3 gwei = ~0.0003 ETH.
PRIORITY_GWEI=3

# Reads only. A private RPC (Alchemy, Infura, your own node) is steadier than the public default.
# RPC_URL=https://ethereum-rpc.publicnode.com

# Dry run without a key: watch this address instead (npm run dry).
# WALLET=0xYourWalletAddress
